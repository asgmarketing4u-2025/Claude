# Scrapegraph-ai Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# LLM API Keys (Choose at least one)
# ============================================

# OpenAI (GPT-4, GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Ollama (Local/Open-source)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Claude (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key

# ============================================
# Proxy Configuration (Optional)
# ============================================

# For rotating proxies
PROXY_LIST=http://proxy1.com:8080,http://proxy2.com:8080,http://proxy3.com:8080

# Single proxy
PROXY_URL=http://proxy.example.com:8080
PROXY_USERNAME=username
PROXY_PASSWORD=password

# ============================================
# Scraping Configuration
# ============================================

# Use headless browser (faster but can't see what's happening)
HEADLESS_MODE=true

# Browser type: chromium, firefox, webkit
BROWSER_TYPE=chromium

# Timeout for page load (seconds)
PAGE_TIMEOUT=30000

# Maximum retries for failed requests
MAX_RETRIES=3

# Delay between requests (seconds)
REQUEST_DELAY=2

# ============================================
# Database Configuration (Optional)
# ============================================

# For storing leads
DATABASE_URL=sqlite:///leads.db
# or PostgreSQL: postgresql://user:password@localhost/db_name

# ============================================
# Export Configuration (Optional)
# ============================================

# Where to save scraped data
OUTPUT_DIR=./output

# File format: csv, json, sqlite
OUTPUT_FORMAT=csv

# ============================================
# Logging Configuration
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/scraper.log

# ============================================
# Scraping Behavior
# ============================================

# JavaScript rendering (slower but handles dynamic content)
RENDER_JAVASCRIPT=true

# Wait for dynamic content to load
WAIT_FOR_SELECTOR=

# Custom user agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Accept cookies automatically
AUTO_ACCEPT_COOKIES=true

# Block images/videos for faster scraping
BLOCK_RESOURCES=false
